# ----------------------------------------------------------------------------
# Zoxide
# ----------------------------------------------------------------------------

# Replace cd with Zoxide's smarter directory navigation.
# Fish's original command remains available as `builtin cd`.
if type -q zoxide
    zoxide init fish --cmd cd | source
end

# ----------------------------------------------------------------------------
# Starship
# ----------------------------------------------------------------------------

set -gx STARSHIP_CONFIG "$HOME/.config/starship.toml"

if type -q starship
    starship init fish | source
    enable_transience
end
